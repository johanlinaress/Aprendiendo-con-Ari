# Configuración de codificación UTF-8 y saltos de línea para Aprendiendo con Ari
* text=auto eol=lf working-tree-encoding=UTF-8

*.js text eol=lf diff=javascript
*.json text eol=lf
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.md text eol=lf
*.svg text eol=lf
*.mp3 binary
*.zip binary
*.png binary
*.jpg binary
*.ico binary
